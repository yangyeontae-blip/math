{
  "name": "berry-forest-plaza",
  "main": "index.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "PLAZA",
        "class_name": "SharedPlaza"
      },
      {
        "name": "PARTIES",
        "class_name": "ForestParty"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SharedPlaza"
      ]
    },
    {
      "tag": "v2-forest-party",
      "new_sqlite_classes": [
        "ForestParty"
      ]
    }
  ]
}

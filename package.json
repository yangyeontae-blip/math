{
  "name": "berry-forest-school",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/copy-legal.mjs && node scripts/build-worker.mjs && node --check dist/server/index.js",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "check:common": "node scripts/check-common.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "test:browser": "playwright test",
    "build:plaza": "node scripts/build-plaza.mjs",
    "test:plaza": "node scripts/build-plaza.mjs && node --import tsx --test realtime/*.test.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.24.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.18.6",
    "@types/three": "^0.180.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "miniflare": "4.20260730.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wrangler": "4.156.1"
  }
}

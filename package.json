  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/three": "^0.180.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
